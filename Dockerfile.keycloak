# Dockerfile.keycloak — Band Manager custom Keycloak image
#
# Extends the official Keycloak 25 image and bakes the bandmanager login
# theme in as a PROVIDER JAR (the only supported, override-proof way).
#
# Why a JAR in /opt/keycloak/providers/ and NOT a folder in /opt/keycloak/themes/?
#   A raw folder at /opt/keycloak/themes/bandmanager takes precedence over a
#   JAR in providers/. If a stale folder is ever left behind (e.g. from an
#   earlier manual deploy or a bind mount), it silently overrides the fixed
#   JAR and you get the old ${locale.locale} FreeMarker crash → HTTP 500.
#   Shipping only the JAR removes that failure mode entirely.
#
# Build (Railway builds this automatically via railway.toml):
#   docker build -f Dockerfile.keycloak -t bandmanager-keycloak .

# --- Stage 1: build the theme JAR with Maven -------------------------------
FROM maven:3.9-eclipse-temurin-21 AS theme-build
WORKDIR /theme-src
COPY themes/bandmanager/pom.xml .
COPY themes/bandmanager/login ./login
COPY themes/bandmanager/src ./src
RUN mvn -B -q clean package -DskipTests

# --- Stage 2: official Keycloak 25 + baked theme JAR -----------------------
FROM quay.io/keycloak/keycloak:25.0

# Drop the fixed theme JAR into providers/ (the supported deploy location).
COPY --from=theme-build /theme-src/target/bandmanager-keycloak-theme.jar /opt/keycloak/providers/

# Defence-in-depth: never let a stale raw folder override the JAR.
# If /opt/keycloak/themes/bandmanager exists from a prior deploy, remove it.
RUN rm -rf /opt/keycloak/themes/bandmanager

# Keycloak 25 Quarkus distribution: the entrypoint is the kc.sh script.
# Railway injects KC_DB_*, KC_HOSTNAME, KC_BOOTSTRAP_ADMIN_*, etc. via env.
# Start in production mode (no dev hot-reload of stale folders).
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized"]
