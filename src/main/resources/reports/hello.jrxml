<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="HelloWorld" pageWidth="595" columnWidth="555" pageHeight="842" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Parameters -->
    <parameter name="message" class="java.lang.String"/>
    <parameter name="user" class="java.lang.String"/>
    <parameter name="generatedDate" class="java.time.LocalDate"/>

    <!-- Title band - using legacy structure without nested band element -->
    <title>
        <reportElement x="0" y="0" width="555" height="100"/>
        <staticText>
            <reportElement x="20" y="25" width="400" height="30"/>
            <textElement verticalAlignment="Middle"><font size="24"/></textElement>
            <text><![CDATA[$P{message}]]></text>
        </staticText>

        <textField>
            <reportElement x="20" y="55" width="500" height="25"/>
            <textElement verticalAlignment="Middle"><font size="14"/></textElement>
            <textFieldExpression><![CDATA["Witaj, " + $P{user} + "!"]]></textFieldExpression>
        </textField>

        <staticText>
            <reportElement x="20" y="80" width="300" height="15"/>
            <textElement verticalAlignment="Middle"><font size="10"/></textElement>
            <text><![CDATA["Generowano: " + $P{generatedDate}]]></text>
        </staticText>
    </title>

    <!-- Page footer with page number -->
    <pageFooter>
        <band height="25">
            <textField>
                <reportElement x="460" y="8" width="100" height="13"/>
                <textElement verticalAlignment="Middle" textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Strona " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>