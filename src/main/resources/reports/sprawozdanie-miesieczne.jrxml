				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["Zakres sprawozdawczy: od  " + new SimpleDateFormat("yyyy-MM-dd").format($P{date_from}) + " do " +  new SimpleDateFormat("yyyy-MM-dd").format($P{date_to}) 
+ "\n\n\nNazwa zespołu " + $P{band_name}
+ "\nInstruktor: " +  $P{instructor_name}
+ "\nLiczba osób w zespole: " + $F{members_active}
+ "\nLiczba dzieci i młodzieży: " + $F{members_younger}
+ "\nLiczba osób powyżej 60 roku życia: " + $F{members_older}
+ "\nLiczba prób: " + $F{rehearsals_count}]]></expression>
