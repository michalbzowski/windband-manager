	<parameter name="band_id" forPrompting="false" class="java.lang.Integer"/>
	<parameter name="date_from" class="java.util.Date"/>
	<parameter name="date_to" class="java.util.Date"/>
	<parameter name="band_name" forPrompting="false" class="java.lang.String"/>
	<parameter name="instructor_name" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT (
	SELECT count(*) as members_active
	FROM members
	WHERE active = true
	AND band_id = $P{band_id}
), 

 (
	SELECT count(*) as members_younger
	FROM members
	WHERE active = true
	AND band_id = $P{band_id} 
	AND date_of_birth < NOW() - INTERVAL '18 years'
	
), 

 (
	SELECT count(*) as members_older
	FROM members
	WHERE active = true
	AND band_id = $P{band_id}
	 AND date_of_birth is not null and date_of_birth > NOW() - INTERVAL '60 years'
), 

 (
	SELECT count(*) as rehearsals_count
	FROM rehearsals
	WHERE band_id = $P{band_id}
	AND date >= CAST($P{date_from} AS DATE)::TIMESTAMP
    AND date < CAST($P{date_to} AS DATE)::TIMESTAMP + INTERVAL '1 day'
)


]]></query>
	<field name="members_active" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="members_active"/>
		<property name="com.jaspersoft.studio.field.label" value="members_active"/>
	</field>
