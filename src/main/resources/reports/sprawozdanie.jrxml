<?xml version="1.0" encoding="UTF-8"?>
<!-- JasperReports 7.x compatible -->
<jasperReport name="SprawozdanieZespolu"
    language="java"
    pageWidth="595" columnWidth="555" pageHeight="842"
    leftMargin="20" rightMargin="20" topMargin="70" bottomMargin="20">

  <property name="com.jaspersoft.studio.data.defaultdataadapter" value="band-manager-prod"/>
  <property name="com.jaspersoft.studio.report.description" value="Band report for city council"/>
  
  <!-- Required property for JRS element format -->
  <property name="net.sf.jasperreports.exporter.html.removeEmptySpaceAfterTextElementBetweenStaticTextAndImage" value="true"/>

  <!-- Parameters -->
  <parameter name="paramFrom" class="java.time.LocalDate"/>
  <parameter name="paramTo" class="java.time.LocalDate"/>
  <parameter name="bandName" class="java.lang.String"/>
  <parameter name="instructorName" class="java.lang.String"/>
  <parameter name="activeMembersCount" class="java.lang.Long"/>
  <parameter name="minorCount" class="java.lang.Long"/>
  <parameter name="senior60PlusCount" class="java.lang.Long"/>

</jasperReport>