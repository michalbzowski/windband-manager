<?xml version="1.0"?>
<!--
  SpotBugs exclusion filter for windband-manager.

  We deliberately suppress EI_EXPOSE_REP / EI_EXPOSE_REP2. These fire on every
  getter/setter that returns or stores a mutable object (List, Map, array,
  custom DTO). In a Spring Boot app the overwhelming majority of such classes
  are plain DTOs / request-response records where exposing the field is the
  whole point. Fixing them everywhere (defensive copies in every accessor)
  would add noise without catching real logic bugs. We keep every other
  category enabled so genuine defects (NPEs, dead stores, useless objects,
  broad exception catches) still fail the build.
-->
<FindBugsFilter>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- ItemView DTO is populated in the controller and consumed by Thymeleaf
         via property access (${itemView.type}, etc.) — SpotBugs cannot see
         that and wrongly flags every public field as unused. -->
    <Match>
        <Class name="pl.michalbzowski.windband.adapter.in.web.InventoryController$ItemView"/>
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <!-- ItemView DTO is populated in the controller and consumed by Thymeleaf
         via property access (${itemView.type}, etc.) — SpotBugs cannot see
         that and wrongly flags every public field as unused. -->
    <Match>
        <Class name="pl.michalbzowski.windband.adapter.in.web.InventoryController$ItemView"/>
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <!-- DefView DTO similarly used by Thymeleaf -->
    <Match>
        <Class name="pl.michalbzowski.windband.adapter.in.web.InventoryController$DefView"/>
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <!-- ScoreAnalysisArtifactQueryService.open(): SpotBugs's NP model cannot see the record
         construction (all three components are provably non-null right before: raw is checked
         against null/blank, path comes from Path.of with an absolute-path guard, mediaType is an
         inlined ternary literal). False positive reported on every refactoring of that return. -->
    <Match>
        <Class name="pl.michalbzowski.windband.application.query.scoreanalysis.ScoreAnalysisArtifactQueryService"/>
        <Method name="open"/>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
</FindBugsFilter>
