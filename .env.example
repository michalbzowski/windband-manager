# ===========================================================================
# Windband Manager — Environment Variables
# ===========================================================================
# Copy this file to .env (or set these in Railway dashboard).
# Values shown are examples from Railway production.
#
# For local development with Docker Compose, use:
#   docker compose up -d db keycloak
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# For local development WITHOUT Docker, use the 'test' profile:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=test
# (Uses H2 + mock OIDC — no external dependencies needed)

# --- Database (PostgreSQL) ---
DB_HOST=your-railway-host.railway.internal
DB_PORT=5432
DB_NAME=windband
DB_USER=windband
DB_PASS=your-password

# --- OIDC / Keycloak ---
KEYCLOAK_CLIENT_ID=windband
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_AUTH_URL=keycloak.your-domain.pl
KEYCLOAK_INTERNAL_URL=keycloak.railway.internal:8080
KEYCLOAK_PUBLIC_URL=keycloak.your-domain.pl
KEYCLOAK_REALM=windband

# --- App ---
BASE_URL=https://windband.your-domain.pl
SERVER_PORT=8080

# --- Superset (Embedded Dashboards) ---
SUPERSET_BASE_URL=http://windband-superset:8088
SUPERSET_PUBLIC_URL=https://superset.michalbzowski.pl
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=Admin123!