# ===========================================================================
# Windband Manager — LOCAL Docker Compose environment
# ===========================================================================
# Everything runs on localhost. You do NOT need to set any of these to start:
#
#     docker compose up -d
#
# The values below are the built-in defaults baked into docker-compose.yml.
# Copy to `.env` and edit only if you want to override something.
# ===========================================================================

# --- App database (PostgreSQL, published on localhost:5432) ---
WINDDB_PASSWORD=windband

# --- Keycloak database (PostgreSQL, published on localhost:5433) ---
KEYCLOAK_DB_PASSWORD=keycloak

# --- Keycloak admin console (http://localhost:8180) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- OIDC client used by the app (auto-imported realm "windband") ---
KEYCLOAK_REALM=windband
KEYCLOAK_CLIENT_ID=windband-local
KEYCLOAK_CLIENT_SECRET=windband-local-secret

# --- App ---
BASE_URL=http://localhost:8080

# --- Mail (optional): point at a local SMTP such as mailpit on 1025.
#     Leaving these as-is only makes outgoing mail fail; the app still runs. ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=

# ---------------------------------------------------------------------------
# Superset is NOT part of the local stack. Leave these unset.
# ---------------------------------------------------------------------------
